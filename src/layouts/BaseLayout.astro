---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { Font } from "astro:assets";
import { THEME_COLOR, type Theme } from "../lib/univers";

interface Props {
  title?: string;
  description?: string;
  /** Ambiance visuelle de la page. Par défaut, la marque (forest). */
  theme?: Theme;
}

const {
  title = "Accompagnateur en Montagne Stagiaire",
  description = "Découvrez la montagne autrement.",
  theme = "forest",
} = Astro.props;

// `site` (astro.config.mjs) est la seule source de vérité sur le domaine :
// sans lui, on échoue au build plutôt que de publier une canonique invalide.
if (!Astro.site) {
  throw new Error("BaseLayout : définir `site` dans astro.config.mjs.");
}

// URL canonique : domaine de `site` (www) + chemin de la page, sans query string
// (?sortie=… sur /contact) ni slash final (trailingSlash: 'never').
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta name="theme-color" content={THEME_COLOR[theme]} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-epilogue"/>
    <Font cssVariable="--font-inter"/>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="aa5a84f9-dbd7-4b4f-9fcc-fca73122f7b6"></script>
  </head>

  <body class="bg-background text-text antialiased">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>