---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("carnet");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title={`${post.data.title} — Carnet`}
  description={post.data.description}
>
  <!-- HEADER DE L'ARTICLE -->
  <section class="bg-primary pb-16 pt-40 md:pb-20 md:pt-48">
    <Container>
      <a
        href="/carnet"
        class="text-sm font-semibold text-white/70 transition hover:text-white"
      >
        ← Tout le carnet
      </a>

      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-white/70">
        {formatDate(post.data.pubDate)}
      </p>
      <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white md:text-5xl">
        {post.data.title}
      </h1>
    </Container>
  </section>

  <!-- CONTENU -->
  <section class="bg-white py-20 md:py-28">
    <Container>
      <article class="post-content mx-auto max-w-2xl">
        <Content />
      </article>
    </Container>
  </section>
</BaseLayout>
