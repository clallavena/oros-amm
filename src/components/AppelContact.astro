---
/**
 * Bandeau d'appel à l'action en bas de page : un titre, une phrase (slot),
 * le bouton « Me contacter » et une action secondaire.
 *
 * - secondaire="telephone" (défaut) : appel direct, pour qui préfère parler.
 * - secondaire="sorties" : renvoi vers le catalogue, pour les pages qui n'en
 *   parlent pas (Qui je suis).
 */
import Container from "./Container.astro";
import Button from "./Button.astro";
import { PHONE_NUMBER, TEL_HREF } from "../lib/site";

interface Props {
  titre: string;
  secondaire?: "telephone" | "sorties";
}

const { titre, secondaire = "telephone" } = Astro.props;
---

<section class="bg-primary py-14 md:py-24">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-[1.75rem] font-bold tracking-tight text-white md:text-5xl">
        {titre}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-white/85 md:mt-4 md:text-lg">
        <slot />
      </p>
      <!-- Mobile : actions empilées pleine largeur, dans la zone du pouce. -->
      <div class="mt-6 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-6 md:mt-8">
        <Button href="/contact" variant="secondary" size="lg" class="group gap-3">
          Me contacter
          <span
            aria-hidden="true"
            class="transition-transform duration-200 motion-safe:group-hover:translate-x-1"
          >→</span>
        </Button>
        <a
          href={secondaire === "telephone" ? TEL_HREF : "/sorties"}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/60 px-7 font-semibold text-white transition hover:bg-white hover:text-primary sm:border-0 sm:px-0 sm:underline sm:underline-offset-4 sm:hover:bg-transparent sm:hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {secondaire === "telephone" ? (
            <>
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
              </svg>
              Appeler le {PHONE_NUMBER}
            </>
          ) : (
            "Voir les sorties"
          )}
        </a>
      </div>
    </div>
  </Container>
</section>
