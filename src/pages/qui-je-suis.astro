---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import {
  TITRE,
  TITRE_MAJ,
  ENCADREMENT,
  MODALITE_LIBELLE,
  type Modalite,
} from "../lib/statut";

import profilImage from "../images/clallavena_profile1.jpg";
import { NOM_SITE } from "../lib/site";

/* ---------- Sommaire (ancres de la page) ---------- */

const sommaire = [
  { id: "histoire", label: "Pourquoi la montagne" },
  { id: "demarche", label: "Ma démarche" },
  { id: "parcours", label: "Mon parcours" },
  { id: "statut", label: "Le statut de stagiaire" },
];

/* ---------- Démarche ---------- */

const valeurs = [
  {
    title: "Au rythme de chacun",
    description:
      "Chaque sortie est adaptée au niveau et aux envies du groupe, pas l'inverse.",
    // horloge
    icone: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2",
  },
  {
    title: "Sécurité avant tout",
    description:
      "Itinéraires préparés en amont, matériel adapté et vigilance constante sur le terrain.",
    // bouclier
    icone: "M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z",
  },
  {
    title: "Transmettre, pas seulement guider",
    description:
      "Comprendre un paysage, reconnaître une plante ou lire une carte : la montagne se partage.",
    // livre
    icone: "M4 19V6a2 2 0 0 1 2-2h12v15H6a2 2 0 0 0-2 2zM8 8h6",
  },
];

/* ---------- Parcours ---------- */

type EtatEtape = "passee" | "en-cours" | "a-venir";

interface Etape {
  annee: string;
  titre: string;
  texte: string;
  etat: EtatEtape;
}

const etapes: Etape[] = [
  {
    annee: "1999",
    titre: "Né au cœur des volcans d'Auvergne",
    texte: "Premiers pas sur les volcans. Premiers souvenirs de randonnée.",
    etat: "passee",
  },
  {
    annee: "2021",
    titre: "Découverte des Pyrénées",
    texte: "L'amour de la montagne prend sens. L'envie de devenir accompagnateur grandit ici.",
    etat: "passee",
  },
  {
    annee: "Mai 2026",
    titre: "Examen probatoire réussi",
    texte: "Après une longue préparation, j'entre dans la formation au diplôme d'État.",
    etat: "passee",
  },
  {
    annee: "Septembre 2026",
    titre: "UF1 et EPMSP validées",
    texte: "Devenant ainsi éducateur sportif stagiaire, je peux encadrer des sorties en montagne.",
    etat: "passee",
  },
  {
    annee: "Aujourd'hui",
    titre: "Stage en situation",
    texte: "J'encadre sous convention de stage, suivi par un accompagnateur diplômé. Je vous emmene en randonnée à la journée, en demi-journée ou en itinérance sur plusieurs jours en refuge.",
    etat: "en-cours",
  },
  {
    annee: "Janvier 2027",
    titre: "Encadrement en raquettes",
    texte: "Après validation de l'UF2, je pourrai encadrer des sorties en raquettes, en co-encadrement.",
    etat: "a-venir",
  },
  {
    annee: "Octobre 2027",
    titre: "Diplôme d'État",
    texte: "Le bivouac et l'itinérance en raquettes rejoindront alors les sorties.",
    etat: "a-venir",
  },
];

/*
 * Frise verticale, sur tous les écrans : elle accepte n'importe quel nombre
 * d'étapes sans passer à la ligne, et elle suit le sens du défilement.
 * L'état ne repose jamais sur la couleur seule (WCAG 1.4.1) : plein,
 * agrandi + badge « Aujourd'hui », ou pointillé pour l'avenir.
 */
const POINT_ETAPE: Record<EtatEtape, string> = {
  passee: "mt-1.5 size-3.5 bg-primary",
  "en-cours": "mt-0.5 size-5 bg-secondary ring-4 ring-primary-light/30",
  "a-venir": "mt-1.5 size-3.5 border-3 border-dashed border-primary-light",
};

/* Trait vertical qui mène à l'étape suivante : plein vers le passé, pointillé vers l'avenir. */
const LIGNE_ETAPE: Record<EtatEtape, string> = {
  passee: "w-[3px] bg-primary",
  "en-cours": "border-l-3 border-dashed border-primary-light",
  "a-venir": "border-l-3 border-dashed border-primary-light",
};

/* ---------- Statut : présentation des modalités ---------- */

/*
 * La donnée (modalité + libellé) vient de lib/statut.ts.
 * L'icône et la couleur sont un choix d'affichage : elles restent ici.
 * Le libellé reste toujours visible : le sens ne repose pas sur la couleur.
 */
const PRESENTATION_MODALITE: Record<Modalite, { icone: string; classe: string }> = {
  autonomie: {
    // coche
    icone: "M5 12l5 5 9-10",
    classe: "text-primary",
  },
  binome: {
    // deux personnes
    icone: "M9 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM17 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15 14.5c3 0 6 2 6 5.5",
    classe: "text-glacier-500",
  },
  "apres-diplome": {
    // horloge
    icone: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2",
    classe: "text-text-muted",
  },
};

/* ---------- FAQ ---------- */

interface Question {
  question: string;
  reponse: string;
  /** Lien affiché sous la réponse (une chaîne ne peut pas contenir de lien cliquable). */
  lien?: { href: string; label: string };
}

const questions: Question[] = [
  {
    question: "Qu'est-ce qu'un accompagnateur stagiaire ?",
    reponse:
      "C'est un accompagnateur en formation au diplôme d'État. Il a réussi l'examen probatoire et les premières unités de formation. Le cursus dure en moyenne trois ans et alterne formation et stage sur le terrain : c'est ce stage que vous vivez avec moi. C'est l'équivalent d'un Aspirant Guide de Haute Montagne (AGHM) pour le diplôme de Guide.",
  },
  {
    question: "Qui suit mon travail ?",
    reponse:
      "J'exerce sous une convention de stage signée avec un accompagnateur diplômé, [nom / structure]. Chaque sortie est consignée dans mon carnet de formation.",
  },
  {
    question: "Êtes-vous assuré ?",
    reponse: `Oui : j'ai une assurance responsabilité civile professionnelle qui couvre mon activité d'${TITRE}, [assureur].`,
  },
  {
    question: "Comment vérifier votre statut ?",
    reponse:
      "Toutes les informations sont publiques : vous pouvez vérifier mon statut, et celui des autres accompagnateurs, sur le site du ministère des Sports.",
    lien: {
      href: "https://recherche-educateur.sports.gouv.fr/accueil",
      label: "Rechercher un éducateur sportif",
    },
  },
];

/* Classes partagées par les en-têtes de section (mêmes valeurs que le hub /sorties). */
const surtitre = "text-sm font-semibold uppercase tracking-widest text-primary";
const titreSection = "mt-3 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-text md:text-4xl";
---

<BaseLayout
  title={`Qui je suis — Clément Allavena, ${TITRE_MAJ}`}
  description={`${TITRE_MAJ}, en formation au diplôme d'État d'accompagnateur en moyenne montagne, je partage ma passion pour la montagne à travers des sorties accompagnées.`}
>
  <!-- ========== HERO : intro + repères + portrait ========== -->
  <!--
    Grille à trois blocs pour changer l'ordre selon l'écran sans dupliquer :
    - mobile : titre → photo → présentation (le visage arrive dès le premier écran) ;
    - md et plus : texte à gauche (titre au-dessus, présentation au-dessous), photo à droite.
    L'ordre du code reste l'ordre de lecture d'un lecteur d'écran.
  -->
  <section class="bg-primary pb-12 pt-28 text-white md:pb-24 md:pt-48">
    <Container>
      <div class="grid gap-y-6 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:items-center md:gap-x-14 md:gap-y-0">
        <div class="md:col-start-1 md:row-start-1 md:self-end">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/75 motion-safe:animate-apparition md:text-sm">
            Qui je suis
          </p>
          <h1 class="mt-3 max-w-2xl text-[2.25rem] font-bold leading-[1.08] tracking-tight motion-safe:animate-apparition motion-safe:[animation-delay:80ms] md:mt-4 md:text-6xl md:leading-[1.05]">
            La montagne, une passion à partager
          </h1>
        </div>

        <div class="overflow-hidden rounded-[22px] md:col-start-2 md:row-span-2 md:row-start-1 md:rounded-[28px]">
          <Image
            src={profilImage}
            alt="Clément Allavena sur le terrain, en montagne"
            widths={[400, 800, 1040]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-4/3 w-full object-cover object-[center_30%] motion-safe:animate-apparition md:aspect-4/5"
            loading="eager"
          />
        </div>

        <div class="md:col-start-1 md:row-start-2 md:self-start">
          <p class="max-w-xl text-[17px] leading-relaxed text-white/85 motion-safe:animate-apparition motion-safe:[animation-delay:160ms] md:mt-6 md:text-xl">
            Je suis Clément Allavena, {TITRE}. Ingénieur informatique de métier, j'ai souhaité accompagner
            celles et ceux qui veulent découvrir la montagne à leur rythme,
            qu'ils soient débutants ou habitués des sentiers.
          </p>

          <!-- Mobile : une ligne par repère, libellé à gauche. md et plus : colonnes. -->
          <dl class="mt-6 border-t border-white/25 text-[15px] motion-safe:animate-apparition motion-safe:[animation-delay:240ms] md:mt-9 md:grid md:grid-cols-[repeat(auto-fit,minmax(min(180px,100%),1fr))] md:gap-5 md:pt-6">
            <div class="grid grid-cols-[7rem_1fr] gap-3 border-b border-white/15 py-3 md:block md:border-0 md:py-0">
              <dt class="text-white/75">Basé à</dt>
              <dd class="font-semibold md:mt-1">Annecy, Haute-Savoie</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 border-b border-white/15 py-3 md:block md:border-0 md:py-0">
              <dt class="text-white/75">Mes massifs de prédilection</dt>
              <dd class="font-semibold md:mt-1">Massif des Bauges, Massif des Bornes-Aravis</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-3 md:block md:py-0">
              <dt class="text-white/75">Statut</dt>
              <dd class="font-semibold md:mt-1">
                <a href="#statut" class="text-white underline underline-offset-4 hover:text-secondary">
                  Stagiaire, diplôme d'État en cours
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </Container>
  </section>

  <!-- ========== SOMMAIRE ========== -->
  <!-- Mobile : grille 2 × 2, les quatre entrées restent visibles (pas de défilement horizontal). -->
  <nav aria-label="Sur cette page" class="border-b border-border bg-surface">
    <Container>
      <ul class="grid grid-cols-2 gap-2 py-3 md:flex md:flex-wrap md:gap-x-7 md:gap-y-2 md:py-0">
        {sommaire.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="flex min-h-12 items-center rounded-2xl bg-background px-3.5 text-sm font-semibold leading-snug text-primary underline-offset-4 hover:underline md:inline-flex md:min-h-14 md:rounded-none md:bg-transparent md:px-0 md:text-[15px]"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </nav>

  <!-- ========== POURQUOI LA MONTAGNE ========== -->
  <section id="histoire" aria-labelledby="histoire-titre" class="py-14 md:py-28">
    <Container>
      <div class="flex flex-wrap gap-x-14 gap-y-6">
        <div class="flex-[1_1_380px]">
          <!-- h2 stylé comme un surtitre : la section garde un titre dans le plan de la page. -->
          <h2 id="histoire-titre" class={surtitre}>Pourquoi la montagne</h2>
          <blockquote class="mt-3.5 font-[family-name:var(--font-epilogue)] text-[clamp(26px,3vw,36px)] md:mt-5 font-bold leading-tight text-primary-hover">
            « Aller là où le regard se pose. »
          </blockquote>
        </div>
        <!-- Texte intégral : sur mobile, paragraphes en 17 px et citations détachées en encadrés. -->
        <div class="flex max-w-[680px] flex-[1.4_1_480px] flex-col gap-4 text-[17px] leading-relaxed md:gap-4.5 md:text-lg">
          <figure class="rounded-2xl bg-surface p-4 text-[15px] md:rounded-none md:bg-transparent md:p-0 md:text-base">
            <blockquote>
              <p>« Quand la montagne vous a pris le cœur, tout vient d'elle et tout vous y ramène. »</p>
            </blockquote>
            <figcaption class="mt-1.5 text-[13px] text-text-muted md:mt-1 md:text-sm">Franz Schrader, pyrénéiste</figcaption>
          </figure>
          <p>C'est ainsi que mon amour de la montagne a pris un réel sens, dans les Pyrénées lors de mes études.
            Je la pratiquais déjà et l'idée de devenir accompagnateur était déjà présente. J'ai toujours aimé transmettre et apprendre de ce milieu.
            Depuis j'ai tout fait pour me rapprocher de ce rêve, et aujourd'hui je suis en formation au diplôme d'État d'accompagnateur en montagne.
          </p>
          <p>Ingénieur informatique de métier, je sais ce qu'implique un métier de bureau et je connais également le sentiment d'évasion que procure la montagne.
            La liberté, le calme, la sérénité, la beauté des paysages, la nature et les rencontres sont autant de raisons qui me poussent à partager ma passion.
          </p>
          <p>
            Mon approche : <b>prendre le temps</b>. Le temps d'observer et de contempler la montagne.
            Dans notre société actuelle, on ne prend parfois plus le temps de prendre le temps. Surtout dans les métiers sédentaires que je connais bien.
            Je propose une vision de la montagne <b>contemplative</b>, où j'essaie de vous transmettre ma vision du temps et de la beauté de l'impermanence dans la nature.
            Mon but à moi est simple : éveiller notre <b>curiosité</b> et <b>stimuler</b> l'enfant qui est en nous.
          </p>
          <figure class="rounded-2xl bg-surface p-4 text-[15px] md:rounded-none md:bg-transparent md:p-0 md:text-base">
            <blockquote>
              <p>« Toutes les grandes personnes ont d’abord été des enfants. Mais peu d’entre elles s’en souviennent. »</p>
            </blockquote>
            <figcaption class="mt-1.5 text-[13px] text-text-muted md:mt-1 md:text-sm">Antoine de Saint-Exupéry, <cite>Le Petit Prince</cite></figcaption>
          </figure>
          <p class="text-base italic text-text-muted">Photographe amateur, toutes les photos de ce site sont issues de mes sorties en montagne.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ========== D'OÙ VIENT LE NOM ========== -->
  <!--
    Encart « dictionnaire ».
    La forme d'une entrée de dictionnaire est immédiatement reconnue : mot,
    prononciation, étymologie, sens numérotés. Le lecteur sait comment la lire
    sans mode d'emploi.

    Ordre du DOM = ordre de lecture mobile : titre, entrée, texte.
    md et plus : l'entrée à gauche, le titre et le texte à droite (grille).
    Cible du lien « D'où vient ce nom ? » du pied de page (#nom).
  -->
  <section id="nom" aria-labelledby="nom-titre" class="bg-primary-light/15 py-14 md:py-28">
    <Container>
      <div class="grid gap-5 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:items-center md:gap-x-11 md:gap-y-4">
        <div class="md:col-start-2 md:row-start-1 md:self-end">
          <h2 id="nom-titre" class={surtitre}>D'où vient le nom</h2>
          <p class="mt-3 font-[family-name:var(--font-epilogue)] text-[1.5rem] font-bold leading-tight text-text md:text-[1.75rem]">
            La montagne, et tous les sens du mot sens.
          </p>
        </div>

        <figure class="rounded-[20px] border border-border bg-surface p-5.5 shadow-[0_10px_30px_rgba(9,20,15,0.06)] md:col-start-1 md:row-span-2 md:row-start-1 md:rounded-[22px] md:p-7.5">
          <p>
            <dfn class="font-[family-name:var(--font-epilogue)] text-[2.125rem] font-bold not-italic leading-none text-text md:text-[2.75rem]">{NOM_SITE}</dfn>
          </p>
          <p class="mt-2 text-[13px] text-text-muted md:mt-2.5 md:text-sm">
            <!-- L'API ne se lit pas à voix haute : on donne une transcription simple aux lecteurs d'écran. -->
            <span aria-hidden="true" class="font-serif">/o.ʁo.sɑ̃s/</span>
            <span class="sr-only">se prononce « o-ro-sanss »</span>
            · mot composé
          </p>

          <dl class="mt-3.5 flex flex-col gap-3 border-t border-primary-light/40 pt-3.5 md:mt-4.5 md:gap-3.5 md:pt-4.5">
            <div class="md:grid md:grid-cols-[5.75rem_1fr] md:items-baseline md:gap-3.5">
              <dt class="font-serif text-[1.1875rem] text-primary md:text-[1.375rem]">
                <span lang="grc">ὄρος</span>
                <span class="ml-1 font-sans text-xs text-text-muted md:hidden">grec ancien</span>
              </dt>
              <dd class="mt-0.5 md:mt-0">
                <span class="hidden text-[13px] text-text-muted md:block">grec ancien</span>
                <span class="font-serif text-base md:text-lg">La montagne.</span>
              </dd>
            </div>
            <div class="md:grid md:grid-cols-[5.75rem_1fr] md:items-baseline md:gap-3.5">
              <dt class="font-serif text-[1.1875rem] text-primary md:text-[1.375rem]">
                sens
                <span class="ml-1 font-sans text-xs text-text-muted md:hidden">français</span>
              </dt>
              <dd class="mt-0.5 md:mt-0">
                <span class="hidden text-[13px] text-text-muted md:block">français</span>
                <ol class="mt-1 flex list-decimal flex-col gap-1 pl-5 font-serif text-[15px] leading-snug md:text-base">
                  <li>La direction, le chemin que l'on prend.</li>
                  <li>La signification, ce qui compte.</li>
                  <li>Nos sens : voir, écouter, sentir, toucher.</li>
                </ol>
              </dd>
            </div>
          </dl>
        </figure>

        <p class="text-base leading-relaxed text-text-muted md:col-start-2 md:row-start-2 md:self-start md:text-[17px]">
          Je cherchais un nom qui dise à la fois où l'on va et comment on y va.
          Oros, la montagne, bien sûr. Et le sens, dans tous ses sens : un chemin
          qu'on choisit ensemble, ce qui compte vraiment quand on prend le
          temps, et tout ce que nos sens perçoivent quand on s'arrête pour
          observer.
        </p>
      </div>
    </Container>
  </section>

  <!-- ========== DÉMARCHE ========== -->
  <section id="demarche" aria-labelledby="demarche-titre" class="bg-surface py-14 md:py-28">
    <Container>
      <p class={surtitre}>Ma démarche</p>
      <h2 id="demarche-titre" class={titreSection}>Ce qui guide chaque sortie</h2>

      <!-- Mobile : une ligne par valeur (picto à gauche). md et plus : trois cartes. -->
      <div data-valeurs class="mt-6 grid md:mt-12 md:grid-cols-3 md:gap-6">
        {valeurs.map((valeur) => (
          <article data-valeur class="grid grid-cols-[3rem_1fr] gap-x-3.5 gap-y-1 border-t border-border py-4.5 last:border-b md:flex md:flex-col md:gap-3 md:rounded-3xl md:border md:bg-background md:p-8 md:last:border-b">
            <span data-valeur-icone
              aria-hidden="true"
              class="row-span-2 flex size-12 items-center justify-center rounded-2xl bg-forest-100 text-primary md:size-13"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={valeur.icone} />
              </svg>
            </span>
            <h3 class="text-lg font-bold leading-snug text-text md:text-xl">{valeur.title}</h3>
            <p class="text-[15px] leading-relaxed text-text-muted md:text-base">{valeur.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- ========== PARCOURS ========== -->
  <!--
    md et plus : titre à gauche (collant pendant le défilement), frise à droite.
    Mobile : titre au-dessus, frise en dessous.
  -->
  <section id="parcours" aria-labelledby="parcours-titre" class="py-14 md:py-28">
    <Container>
      <div class="md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] md:items-start md:gap-x-16">
        <div class="md:sticky md:top-28">
          <p class={surtitre}>Mon parcours</p>
          <h2 id="parcours-titre" class={titreSection}>Du randonneur au professionnel</h2>
        </div>

        <ol data-frise class="mt-8 flex flex-col md:mt-0">
          {etapes.map((e, i) => (
            <li data-etape
              aria-current={e.etat === "en-cours" ? "step" : undefined}
              class="grid grid-cols-[1.25rem_1fr] gap-x-3.5 md:grid-cols-[1.5rem_1fr] md:gap-x-6"
            >
              <!-- Repère de la frise (décoratif : l'état est dit par le texte et aria-current). -->
              <span aria-hidden="true" class="flex flex-col items-center">
                <span data-etape-point class={`shrink-0 rounded-full ${POINT_ETAPE[e.etat]}`}></span>
                {i < etapes.length - 1 && <span data-etape-ligne class={`flex-1 ${LIGNE_ETAPE[e.etat]}`}></span>}
              </span>

              <div data-etape-contenu class="flex flex-col gap-1 pb-6 md:gap-1.5 md:pb-9">
                {e.etat === "en-cours" ? (
                  <span class="self-start rounded-full bg-secondary px-2.5 py-0.5 text-[13px] font-bold text-on-secondary">
                    {e.annee}
                  </span>
                ) : (
                  <span class="text-[13px] font-semibold text-text-muted md:text-sm">{e.annee}</span>
                )}
                <b class="font-[family-name:var(--font-epilogue)] text-[17px] leading-snug text-text md:text-xl">{e.titre}</b>
                <span class="max-w-prose text-[15px] leading-relaxed text-text-muted md:text-base">{e.texte}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </Container>
  </section>

  <!-- ========== STATUT ========== -->
  <section id="statut" aria-labelledby="statut-titre" class="bg-surface py-14 md:py-28">
    <Container>
      <p class={surtitre}>Le statut de stagiaire</p>
      <h2 id="statut-titre" class={titreSection}>
        Stagiaire, ça veut dire quoi pour votre sortie ?
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted md:mt-5 md:text-lg">
        Pendant ma formation, la loi m'autorise à encadrer dans un cadre
        précis. Voici exactement ce que je peux vous proposer aujourd'hui.
      </p>

      <!--
        Même donnée, deux présentations :
        - mobile : une liste « sortie → modalité », lisible sans défilement horizontal (WCAG 1.4.10) ;
        - md et plus : le tableau.
        La version masquée est en display:none, donc absente pour les lecteurs d'écran : pas de doublon.
      -->
      <ul
        aria-label="Sorties possibles selon mon statut de stagiaire"
        class="mt-6 divide-y divide-border overflow-hidden rounded-2xl border border-border md:hidden"
      >
        {ENCADREMENT.map((ligne) => (
          <li
            class:list={[
              "flex flex-col gap-1 px-4 py-3.5",
              ligne.modalite === "apres-diplome" && "bg-background",
            ]}
          >
            <span class="text-[15px] font-bold text-text">{ligne.sortie}</span>
            <span class={`inline-flex items-center gap-2 text-[15px] font-semibold ${PRESENTATION_MODALITE[ligne.modalite].classe}`}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                <path d={PRESENTATION_MODALITE[ligne.modalite].icone} />
              </svg>
              {MODALITE_LIBELLE[ligne.modalite]}
            </span>
          </li>
        ))}
      </ul>

      <div class="mt-10 hidden overflow-x-auto rounded-2xl border border-border md:block">
        <table class="w-full min-w-[640px] border-collapse text-left">
          <caption class="sr-only">Sorties possibles selon mon statut de stagiaire</caption>
          <thead>
            <tr class="bg-forest-100">
              <th scope="col" class="px-6 py-4 text-sm font-semibold text-text">Sortie</th>
              <th scope="col" class="px-6 py-4 text-sm font-semibold text-text">Aujourd'hui</th>
            </tr>
          </thead>
          <tbody>
            {ENCADREMENT.map((ligne) => (
              <tr class="border-t border-border">
                <th scope="row" class="px-6 py-4 font-semibold text-text">{ligne.sortie}</th>
                <td class="px-6 py-4">
                  <span class={`inline-flex items-center gap-2 font-semibold ${PRESENTATION_MODALITE[ligne.modalite].classe}`}>
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d={PRESENTATION_MODALITE[ligne.modalite].icone} />
                    </svg>
                    {MODALITE_LIBELLE[ligne.modalite]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="mt-10 text-[1.375rem] font-bold text-text md:mt-16 md:text-2xl">Vos questions</h3>
      <!-- <details> natif : clavier et lecteurs d'écran sans JS, plusieurs réponses ouvertes à la fois. -->
      <div class="mt-4 flex max-w-[880px] flex-col gap-2.5 md:mt-5 md:gap-3">
        {questions.map((q, i) => (
          <details open={i === 0} class="group rounded-2xl border border-border bg-background px-4 md:px-6">
            <!-- min-h-14 : une question sur deux lignes reste facile à toucher. -->
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 py-2 text-base font-semibold leading-snug text-text md:gap-4 md:py-5 md:text-[17px] [&::-webkit-details-marker]:hidden">
              {q.question}
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary transition-transform group-open:rotate-180">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="pb-4 text-[15px] leading-relaxed text-text-muted md:pb-5 md:text-base">
              {q.reponse}
              {q.lien && (
                <>
                  {" "}
                  <!-- Mobile : vrai bouton pleine largeur (action de vérification). md et plus : lien dans le texte. -->
                  <a
                    href={q.lien.href}
                    class="mt-3 flex min-h-12 items-center justify-center rounded-full border border-primary font-semibold text-primary hover:bg-primary hover:text-white md:mt-0 md:inline md:min-h-0 md:rounded-none md:border-0 md:underline md:underline-offset-4 md:hover:bg-transparent md:hover:text-primary-hover"
                  >
                    {q.lien.label}
                  </a>
                </>
              )}
            </p>
          </details>
        ))}
      </div>
    </Container>
  </section>

  <!-- ========== CTA ========== -->
  <section class="bg-primary py-14 md:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-[1.75rem] font-bold tracking-tight text-white md:text-4xl">
          Envie de partir ensemble ?
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-white/80 md:mt-4 md:text-lg">
          Découvrez les sorties proposées ou contactez-moi pour construire la vôtre.
        </p>
        <!-- Mobile : boutons empilés pleine largeur, dans la zone du pouce. -->
        <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-4 md:mt-8">
          <Button href="/sorties" variant="secondary" size="lg">Voir les sorties</Button>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full border border-white/60 px-9 py-4 text-base font-semibold text-white transition hover:bg-white hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Me contacter
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Seulement si l'utilisateur n'a pas demandé moins d'animations.
  // matchMedia annule tout automatiquement si la préférence change.
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const frise = document.querySelector("[data-frise]");
    if (!frise) return;

    /* Animation Timeline */
    // Une seule timeline, déclenchée par l'arrivée de la frise à l'écran.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: frise,
        start: "top 80%",
        end: "bottom 30%",
        once: true,
        toggleActions: "play complete none none",
      },
      defaults: { ease: "power2.out" },
    });

    gsap.utils.toArray<HTMLElement>("[data-etape]").forEach((etape) => {
      const point = etape.querySelector("[data-etape-point]");
      const contenu = etape.querySelector("[data-etape-contenu]");
      const ligne = etape.querySelector("[data-etape-ligne]");

      // Sans position, chaque ajout se place à la fin de la timeline :
      // les étapes s'enchaînent donc dans l'ordre.
      tl.from(point, { scale: 0, duration: 0.3 })
        .from(contenu, { opacity: 0, y: 16, duration: 0.4 }, "<0.1");

      if (ligne) {
        tl.from(
          ligne,
          { scaleY: 0, transformOrigin: "top center", duration: 0.35, ease: "none" },
          "<0.15",
        );
      }
    });

      /* ---------- Valeurs : apparition au défilement ---------- */

    const blocValeurs = document.querySelector("[data-valeurs]");

    if (blocValeurs) {
      gsap.from("[data-valeur]", {
        opacity: 0,
        y: 24,
        duration: 0.5,
        ease: "power2.out",
        stagger: 0.12, // les blocs arrivent l'un après l'autre
        scrollTrigger: {
          trigger: blocValeurs,
          start: "top 80%",
          once: true,
        },
      });
    }

    /* ---------- Valeurs : le picto s'agite au survol ou au toucher ---------- */

    const icones = gsap.utils.toArray<HTMLElement>("[data-valeur-icone]");
    const nettoyages: Array<() => void> = [];

    icones.forEach((icone) => {
      const carte = icone.closest<HTMLElement>("[data-valeur]");
      if (!carte) return;

      const agiter = () => {
        // Pas de nouvelle secousse tant que la précédente n'est pas finie.
        if (gsap.isTweening(icone)) return;
        gsap.to(icone, {
          keyframes: { rotation: [0, -8, 7, -4, 2, 0] },
          duration: 0.6,
          ease: "power1.inOut",
        });
      };

      // Souris : quand le pointeur entre sur la carte.
      const auSurvol = (e: PointerEvent) => {
        if (e.pointerType === "mouse") agiter();
      };
      // Tactile ou stylet : au toucher.
      const auToucher = (e: PointerEvent) => {
        if (e.pointerType !== "mouse") agiter();
      };

      carte.addEventListener("pointerenter", auSurvol);
      carte.addEventListener("pointerdown", auToucher);

      nettoyages.push(() => {
        carte.removeEventListener("pointerenter", auSurvol);
        carte.removeEventListener("pointerdown", auToucher);
      });
    });
      
    // Si l'utilisateur active « réduire les animations » en cours de route,
    // matchMedia annule les animations GSAP… et appelle cette fonction pour
    // retirer nos écouteurs.
    return () => nettoyages.forEach((retirer) => retirer());
  });
  

</script>
