---
/*
 * Fiche d'une sortie : /sorties/<univers>/<id>
 * Design : planche « 3b · Fiche sortie type ».
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
import Button from "../../../components/Button.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { UNIVERS_INFO } from "../../../lib/univers";
import { getSorties, getSortiesProches, type Sortie } from "../../../lib/sorties";
import {
  FORMAT_LABEL,
  NIVEAU_LABEL,
  formatPrix,
  formatNombre,
  formatPeriode,
  formatPlaces,
} from "../../../lib/formats";
import SortieCardCompacte from "../../../components/SortieCardCompacte.astro";

export async function getStaticPaths() {
  const sorties = await getSorties();
  return sorties.map((sortie) => ({
    params: { univers: sortie.data.univers, slug: sortie.id },
    props: { sortie },
  }));
}

interface Props {
  sortie: Sortie;
}

const { sortie } = Astro.props;
const { data } = sortie;
const { Content } = await render(sortie);
const info = UNIVERS_INFO[data.univers];

/* ---------- Chiffres clés : seulement ceux qui sont renseignés ---------- */
const chiffres: { label: string; valeur: string }[] = [];
if (data.duree) chiffres.push({ label: "Durée", valeur: data.duree });
if (data.marcheParJour) chiffres.push({ label: "Marche / jour", valeur: data.marcheParJour });
if (data.distanceKm) chiffres.push({ label: "Distance", valeur: `${formatNombre(data.distanceKm)} km` });
if (data.deniveleM !== undefined) chiffres.push({ label: "Dénivelé", valeur: `+${formatNombre(data.deniveleM)} m` });
if (data.altitudeMaxM) chiffres.push({ label: "Altitude max.", valeur: `${formatNombre(data.altitudeMaxM)} m` });
chiffres.push({ label: "Niveau", valeur: NIVEAU_LABEL[data.niveau] });
chiffres.push({
  label: "Groupe",
  valeur: data.groupe.max
    ? `${data.groupe.min} à ${data.groupe.max} pers.`
    : `Dès ${data.groupe.min} pers.`,
});

/* ---------- Photos : la couverture en grand, 2 photos de la galerie à côté ---------- */
const [photoPrincipale, ...autresPhotos] = [data.couverture, ...data.galerie];
const photosCote = autresPhotos.slice(0, 2);

/*
 * ---------- Prochains départs ----------
 * Site statique : « à venir » est évalué au moment du build. Une date passée
 * reste affichée jusqu'au prochain build (pense à rebuilder régulièrement).
 */
const debutDuJour = new Date();
debutDuJour.setHours(0, 0, 0, 0);
const prochainsDeparts = data.departs
  .filter((d) => d.debut >= debutDuJour)
  .sort((a, b) => a.debut.valueOf() - b.debut.valueOf())
  .slice(0, 3);

const contactHref = `/contact?sortie=${sortie.id}`;

const proches = await getSortiesProches(sortie);
---

<BaseLayout
  title={`${data.title} — ${info.label} — Clément Allavena`}
  description={data.description}
  theme={info.theme}
>
  <!-- ========== EN-TÊTE ========== -->
  <section class="bg-hero pb-12 pt-40 md:pb-16 md:pt-44">
    <Container>
      <nav aria-label="Fil d'Ariane" class="text-sm text-white/85">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/sorties" class="text-white underline underline-offset-4">Sorties</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/sorties/${data.univers}`} class="text-white underline underline-offset-4">
              {info.label}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {data.itineraireType && (
          <span class="rounded-full bg-secondary px-3 py-1 text-[13px] font-bold text-on-secondary">
            Sortie type
          </span>
        )}
        <span class="rounded-full bg-white/15 px-3 py-1 text-[13px] font-semibold text-white">
          {FORMAT_LABEL[data.format]}{data.duree && ` · ${data.duree}`}
        </span>
      </div>

      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-[1.05] tracking-tight text-white md:text-6xl">
        {data.title}
      </h1>

      {data.lieu && (
        <p class="mt-3 flex items-center gap-2 text-[17px] text-white/90">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          Massif {data.lieu.massif}
          {data.lieu.depart && <> · Départ {data.lieu.depart}</>}
        </p>
      )}
    </Container>
  </section>

  <!-- ========== PHOTOS ========== -->
  <Container class="pt-8">
    <div class:list={["grid gap-4", photosCote.length > 0 && "md:grid-cols-3"]}>
      <Image
        src={photoPrincipale.src}
        alt={photoPrincipale.alt}
        widths={[640, 960, 1280]}
        sizes={photosCote.length > 0 ? "(min-width: 768px) 66vw, 100vw" : "100vw"}
        class:list={[
          "h-72 w-full rounded-3xl object-cover md:h-[420px]",
          photosCote.length > 0 && "md:col-span-2",
        ]}
        loading="eager"
      />
      {photosCote.length > 0 && (
        <div class="grid gap-4">
          {photosCote.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 640]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="h-48 w-full rounded-3xl object-cover md:h-full"
            />
          ))}
        </div>
      )}
    </div>
  </Container>

  <!-- ========== CHIFFRES CLÉS ========== -->
  <Container class="pt-6">
    <!--
      Les traits entre les cases : la grille a un fond couleur bordure et un
      espacement de 1 px, et chaque case un fond blanc. Le fond ne se voit que
      dans les interstices, quel que soit le nombre de cases par ligne.
    -->
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]">
      {chiffres.map((c) => (
        <div class="bg-surface px-6 py-5">
          <dt class="text-[13px] text-text-muted">{c.label}</dt>
          <dd class="mt-1 text-xl font-bold text-text">{c.valeur}</dd>
        </div>
      ))}
    </dl>
  </Container>

  <!-- ========== CORPS + RÉSERVATION ========== -->
  <Container class="py-14 md:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_340px]">
      <div class="flex min-w-0 flex-col gap-14">

        <!-- L'idée -->
        <section aria-labelledby="idee-titre">
          <h2 id="idee-titre" class="text-3xl font-bold leading-tight text-text">L'idée</h2>
          <div class="fiche-content mt-4 max-w-2xl">
            <Content />
          </div>

          {data.themes.length > 0 && (
            <ul aria-label="Thèmes abordés" class="mt-5 flex flex-wrap gap-2">
              {data.themes.map((theme) => (
                <li class="rounded-full bg-primary-light/30 px-3.5 py-1.5 text-sm font-semibold text-primary">
                  {theme}
                </li>
              ))}
            </ul>
          )}
        </section>

        <!-- Le programme -->
        {data.programme.length > 0 && (
          <section aria-labelledby="programme-titre">
            <h2 id="programme-titre" class="text-3xl font-bold leading-tight text-text">Le programme</h2>
            <ol class="mt-6">
              {data.programme.map((etape) => (
                <li class="grid grid-cols-[96px_1fr] gap-5 border-t border-border py-4.5 last:border-b">
                  <span class="font-[family-name:var(--font-epilogue)] font-bold text-primary">
                    {etape.moment}
                    {etape.heure && (
                      <span class="block font-sans text-sm font-medium text-text-muted">{etape.heure}</span>
                    )}
                  </span>
                  <span class="text-text">{etape.texte}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        <!-- Le terrain (profil altimétrique et carte : lot ultérieur) -->
        {data.niveauDetail && (
          <section aria-labelledby="terrain-titre">
            <h2 id="terrain-titre" class="text-3xl font-bold leading-tight text-text">Le terrain</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-text">
              <b class="font-semibold">Niveau : {NIVEAU_LABEL[data.niveau].toLowerCase()}.</b>
              {data.niveauDetail}
            </p>
          </section>
        )}

        <!-- Itinéraire type -->
        {data.itineraireType && (
          <div class="flex items-start gap-4 rounded-3xl border border-dashed border-border-strong bg-surface p-6">
            <svg
              aria-hidden="true"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-primary"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 8v5M12 16.5v.5" />
            </svg>
            <p class="text-text">
              <b class="font-semibold">Itinéraire type.</b> Il sert de base :
              selon la météo, l'enneigement et le groupe, je peux choisir une
              variante. Vous êtes prévenus avant le départ.
            </p>
          </div>
        )}
      </div>

      <!-- ========== RÉSERVATION ========== -->
      <aside
        aria-labelledby="reserver-titre"
        class="flex flex-col gap-5 rounded-3xl border border-border bg-surface p-7 shadow-lg shadow-primary/5 lg:sticky lg:top-28"
      >
        <h2 id="reserver-titre" class="sr-only">Réserver</h2>

        <div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm text-text-muted">Dès, par personne</span>
            <span class="text-3xl font-bold text-primary">{formatPrix(data.prix.des)}</span>
          </div>
          {data.prix.jusqua && (
            <p class="mt-1 text-right text-sm text-text-muted">
              Jusqu'à {formatPrix(data.prix.jusqua)} par personne
            </p>
          )}
        </div>

        <div>
          <h3 class="text-base font-semibold text-text">Prochains départs</h3>
          {prochainsDeparts.length > 0 ? (
            <ul class="mt-3 flex flex-col gap-2 text-[15px]">
              {prochainsDeparts.map((d) => (
                <li class="flex justify-between gap-3 rounded-xl bg-background px-3.5 py-3">
                  <time datetime={d.debut.toISOString().slice(0, 10)} class="font-semibold text-text">
                    {formatPeriode(d.debut, d.fin)}
                  </time>
                  {d.places !== undefined && (
                    <span class:list={["text-text-muted", d.places === 0 && "font-semibold"]}>
                      {formatPlaces(d.places)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-text-muted">
              Pas de date programmée pour l'instant : proposez la vôtre.
            </p>
          )}
        </div>

        {prochainsDeparts.length > 0 ? (
          <div class="flex flex-col gap-3">
            <Button href={contactHref} class="w-full">Réserver une date</Button>
            <Button href={`${contactHref}&groupe=1`} variant="ghost" class="w-full">
              Proposer une date pour mon groupe
            </Button>
          </div>
        ) : (
          <Button href={`${contactHref}&groupe=1`} class="w-full">Proposer une date</Button>
        )}

        <ul class="flex list-disc flex-col gap-2 border-t border-border pl-5 pt-4 text-sm text-text-muted">
          <li>
            Accompagnateur en montagne stagiaire, sous convention de stage ·
            <a href="/a-propos" class="font-semibold text-primary underline">mon statut</a>
          </li>
          {data.inclus.map((item) => <li>{item}</li>)}
          {data.annulation && <li>{data.annulation}</li>}
        </ul>
      </aside>
    </div>
  </Container>
  
  <!-- ========== SORTIES PROCHES ========== -->
   {
    proches.length > 0 && (
      <section aria-labelledby="proches-titre" class="bg-white py-20">
        <Container>
          <h2 id="proches-titre" class="text-3xl font-bold leading-tight text-text">Dans le même esprit</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {proches.map((s) => <SortieCardCompacte sortie={s} headingLevel={3} />)}
          </div>
        </Container>
      </section>
    )
   }
</BaseLayout>

<style>
  .fiche-content :global(p) {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .fiche-content :global(p:first-child) {
    margin-top: 0;
  }
</style>
