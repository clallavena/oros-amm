---
interface Props {
  title: string;
  description?: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

<article
  class="
    overflow-hidden
    rounded-2xl
    border
    border-border
    bg-surface
    transition
    duration-300
    hover:-translate-y-1
    hover:shadow-lg
  "
>
  <div class="aspect-[4/3] bg-primary-light">
    <!-- Image à ajouter ensuite -->
  </div>

  <div class="p-6">
    <h3 class="text-xl font-semibold text-text">
      {title}
    </h3>

    {description && (
      <p class="mt-3 leading-relaxed text-text-muted">
        {description}
      </p>
    )}

    {href && (
      <a
        href={href}
        class="mt-5 inline-block font-semibold text-primary hover:underline"
      >
        Découvrir →
      </a>
    )}
  </div>
</article>