---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";

import randonneeImage from "../images/randonnee.jpg";
import natureImage from "../images/nature.jpg";
import sortieImage from "../images/sortie.jpg";

const sorties = [
  {
    image: randonneeImage,
    alt: "Randonnée sur un sentier de montagne",
    tag: "Demi-journée",
    niveau: "Tous niveaux",
    title: "Balade découverte",
    description:
      "Une sortie courte et accessible pour prendre l'air, observer le paysage et s'initier à la randonnée en moyenne montagne.",
  },
  {
    image: natureImage,
    alt: "Faune et flore de montagne",
    tag: "Journée complète",
    niveau: "Niveau intermédiaire",
    title: "Immersion nature",
    description:
      "Une journée pour apprendre à observer et comprendre la faune, la flore et les paysages qui nous entourent.",
  },
  {
    image: sortieImage,
    alt: "Sortie accompagnée en montagne",
    tag: "Sur mesure",
    niveau: "Adapté à votre niveau",
    title: "Sortie personnalisée",
    description:
      "Un itinéraire pensé selon vos envies, votre rythme et vos objectifs — en solo, en famille ou entre amis.",
  },
];
---

<BaseLayout
  title="Sorties — Clément Allavena, Accompagnateur en Montagne"
  description="Découvrez les différentes sorties accompagnées en moyenne montagne : balades découverte, immersion nature et sorties sur mesure."
>
  <!-- HEADER DE PAGE -->
  <section class="bg-primary pb-20 pt-40 md:pb-28 md:pt-48">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/70">
        Sorties
      </p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white md:text-6xl">
        Des sorties pour tous les rythmes
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
        Que vous souhaitiez une balade tranquille ou une journée
        d'immersion complète, chaque sortie est pensée pour prendre
        le temps de découvrir la montagne.
      </p>
    </Container>
  </section>

  <!-- LISTE DES SORTIES -->
  <section class="bg-background py-24 md:py-32">
    <Container>
      <div class="grid gap-6 md:grid-cols-3">
        {sorties.map((sortie) => (
          <article
            class="group overflow-hidden rounded-2xl bg-surface shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="aspect-4/3 overflow-hidden bg-primary-light">
              <Image
                src={sortie.image}
                alt={sortie.alt}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-primary-light/30 px-3 py-1 text-xs font-semibold text-primary">
                  {sortie.tag}
                </span>
                <span class="text-xs font-medium text-text-muted">
                  {sortie.niveau}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-bold">
                {sortie.title}
              </h3>

              <p class="mt-3 leading-relaxed text-text-muted">
                {sortie.description}
              </p>

              <a
                href="/contact"
                class="mt-5 inline-block font-semibold text-primary"
              >
                Réserver cette sortie →
              </a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="bg-white py-24 md:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <SectionTitle
          align="center"
          eyebrow="Besoin de conseils ?"
          title="Vous ne savez pas quelle sortie choisir ?"
          description="Parlez-moi de vos envies, de votre niveau et de vos disponibilités, je vous aide à construire la sortie qui vous correspond."
        />
        <div class="mt-8 flex justify-center">
          <Button href="/contact">Me contacter</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
