---
/**
 * En-tête de section : surtitre (optionnel), titre h2, description (optionnelle).
 * Une seule échelle typographique pour tout le site : 30 px sur mobile, 36 px dès md.
 *
 * Le bloc est limité à max-w-2xl : on peut le placer dans une ligne flex
 * (par exemple avec un lien « Tout le carnet → » en face).
 */
import { SURTITRE } from "../lib/classes";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  /** id du h2, référencé par aria-labelledby sur la section : unique dans la page. */
  id?: string;
  /** true = le h2 peut recevoir le focus par script (tabindex="-1"), sans contour visible. */
  focusable?: boolean;
}

const { eyebrow, title, description, align = "left", id, focusable = false } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class={SURTITRE}>{eyebrow}</p>}

  <h2
    id={id}
    tabindex={focusable ? -1 : undefined}
    class:list={[
      "text-3xl font-bold leading-tight tracking-tight text-text md:text-4xl",
      eyebrow && "mt-3",
      focusable && "focus:outline-none",
    ]}
  >
    {title}
  </h2>

  {description && <p class="mt-4 text-lg leading-relaxed text-text-muted">{description}</p>}
</div>
