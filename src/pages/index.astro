---
/*
 *Page d'accueil du site.

 *- Le contenu de la page est entièrement calculé depuis le contenu publié :
 *- les portes d'entrée sont construites depuis les sorties publiées,
 *- les trois premières sorties sont affichées dans "Pour commencer",
 *- les deux derniers articles du Carnet sont affichés dans "Conseils et récits de terrain".

 *L'objectif est de donner un aperçu des possibilités, sans tout détailler.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import UniversPorte from "../components/UniversPorte.astro";
import SortieCard from "../components/SortieCard.astro";
import SortieCardCompacte from "../components/SortieCardCompacte.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { TITRE, GARANTIES } from "../lib/statut";
import { UNIVERS } from "../lib/univers";
import { getSorties, resumer } from "../lib/sorties";
import { PHONE_NUMBER, ZONE_ACTIVITE } from "../lib/site";

import heroImage from "../images/hero-montagne.jpg";
import portraitImage from "../images/clallavena_profile1.jpg";

/* ---------- Données ---------- */

const sorties = await getSorties();

const portes = UNIVERS.map((u) => ({
  univers: u,
  resume: resumer(sorties.filter((s) => s.data.univers === u)),
}));

/* « Pour commencer » : les trois premières sorties, dans l'ordre éditorial. */
const aLaUne = sorties.slice(0, 3);

/* Les deux derniers articles du Carnet. */
const articles = (await getCollection("carnet"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Europe/Paris",
  });

const telHref = `tel:${PHONE_NUMBER.replace(/[\s\-\(\)]/g, "")}`;

/* Classes partagées par les en-têtes de section (mêmes valeurs que le hub /sorties). */
const surtitre = "text-sm font-semibold uppercase tracking-widest text-primary";
const titreSection = "mt-3 text-3xl font-bold leading-tight tracking-tight text-text md:text-4xl";
const lienSection =
  "inline-flex min-h-11 items-center font-semibold text-primary underline-offset-4 hover:underline";
---

<BaseLayout
  title={`Clément Allavena — Accompagnateur en montagne`}
  description={`Randonnées découverte, raquettes et itinérances en refuge autour d'Annecy, et ailleurs avec Clément Allavena, ${TITRE}.`}
>
  <!-- ========== HERO ========== -->
  <section class="relative flex min-h-[640px] flex-col overflow-hidden bg-forest-800 text-white md:min-h-[760px]">
    <!-- Décorative : le texte du hero porte le message, d'où alt="". -->
    <Image
      src={heroImage}
      alt=""
      widths={[640, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[40%_55%] md:object-center"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-black/85 via-black/45 to-black/30"
    ></div>

    <!-- pb : la place des portes d'entrée, qui chevauchent le bas du hero. -->
    <Container class="relative z-10 mt-auto pb-28 pt-32 md:pb-44">
      <div class="max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-semibold text-white/90">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          {ZONE_ACTIVITE.join(" · ")}
        </p>

        <h1 class="mt-4 text-[2.75rem] font-bold leading-[1.02] tracking-tight md:mt-5 md:text-7xl lg:text-[5.5rem] lg:leading-none">
          La montagne, à hauteur de pas.
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/90 md:mt-6 md:text-xl">
          Randonnées découverte, raquettes et itinérances en refuge autour
          d'Annecy et ailleurs, pour prendre le temps de comprendre la montagne.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-8">
          <Button href="#univers" variant="secondary" size="lg">
            Choisir une sortie
          </Button>
          <a
            href="/qui-je-suis"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/60 px-7 font-semibold text-white transition hover:bg-white hover:text-primary"
          >
            Qui je suis
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ========== PORTES D'ENTRÉE ========== -->
  <section
    id="univers"
    aria-labelledby="univers-titre"
    class="relative z-10 -mt-18 pb-16 md:-mt-28 md:pb-26"
  >
    <Container>
      <h2 id="univers-titre" class="sr-only">Choisir un univers</h2>

      <!--
        Mobile : une seule liste blanche, lignes séparées par un filet.
        md et plus : trois cartes indépendantes (chaque <li> porte son fond).
      -->
      <ul
        class="divide-y divide-border overflow-hidden rounded-3xl bg-surface shadow-xl shadow-black/15 md:grid md:grid-cols-3 md:gap-5 md:divide-y-0 md:overflow-visible md:rounded-none md:bg-transparent md:shadow-none"
      >
        {portes.map(({ univers, resume }) => (
          <UniversPorte univers={univers} resume={resume} />
        ))}
      </ul>

      <p class="mt-4 flex flex-wrap items-center gap-x-4 md:mt-6">
        <span class="text-text-muted">Vous venez avec une classe ou une équipe ?</span>
        <a href="/groupes" class={lienSection}>
          Sorties pour les groupes →
        </a>
      </p>
    </Container>
  </section>

  <!-- ========== POUR COMMENCER ========== -->
  {aLaUne.length > 0 && (
    <section aria-labelledby="une-titre" class="bg-surface py-16 md:py-26">
      <Container>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <p class={surtitre}>Pour commencer</p>
            <h2 id="une-titre" class={titreSection}>
              {aLaUne.length > 1 ? "Quelques façons de partir avec moi" : "Une façon de partir avec moi"}
            </h2>
          </div>
          <a href="/sorties" class={`${lienSection} hidden md:inline-flex`}>
            Toutes les sorties →
          </a>
        </div>

        <!-- Mobile : cartes compactes empilées (pas de carrousel). -->
        <ul class="mt-8 flex flex-col gap-2 md:hidden">
          {aLaUne.map((sortie) => (
            <li><SortieCardCompacte sortie={sortie} /></li>
          ))}
        </ul>

        <!-- md et plus : cartes complètes. -->
        <ul class="mt-11 hidden gap-6 md:grid md:grid-cols-3">
          {aLaUne.map((sortie) => (
            <li class="grid"><SortieCard sortie={sortie} /></li>
          ))}
        </ul>

        <div class="mt-6 md:hidden">
          <Button href="/sorties" variant="ghost" class="w-full">Toutes les sorties</Button>
        </div>
      </Container>
    </section>
  )}

  <!-- ========== VOTRE ACCOMPAGNATEUR ========== -->
  <section aria-labelledby="clement-titre" class="py-16 md:py-28">
    <Container>
      <div class="flex flex-wrap items-center gap-x-14 gap-y-8">
        <div class="w-full overflow-hidden rounded-3xl md:max-w-[520px] md:flex-[1_1_380px]">
          <Image
            src={portraitImage}
            alt="Clément Allavena en randonnée, le mont Blanc en arrière-plan"
            widths={[400, 800, 1040]}
            sizes="(min-width: 768px) 520px, 100vw"
            class="aspect-4/3 w-full object-cover object-[center_35%] md:aspect-4/5"
          />
        </div>

        <div class="flex min-w-0 flex-[1.2_1_480px] flex-col gap-4">
          <p class={surtitre}>Votre accompagnateur</p>
          <h2 id="clement-titre" class="text-3xl font-bold leading-tight tracking-tight text-text md:text-4xl">
            Bonjour, moi c'est Clément.
          </h2>
          <p class="max-w-xl text-lg leading-relaxed text-text">
            Ingénieur informatique de métier, j'ai choisis de sortir de mon bureau pour accompagner les gens à découvrir la montagne autrement. Mon
            approche : prendre le temps d'observer, de comprendre, de respirer.
          </p>

          <ul class="mt-2 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3 sm:gap-3 sm:overflow-visible sm:rounded-none sm:border-0 sm:bg-transparent">
            {GARANTIES.map((g) => (
              <li class="flex items-start gap-3 bg-surface p-4 sm:flex-col sm:gap-2 sm:rounded-2xl sm:border sm:border-border">
                <svg
                  aria-hidden="true"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 shrink-0 text-primary sm:mt-0"
                >
                  <path d={g.icone} />
                </svg>
                <span class="flex flex-col gap-0.5">
                  <b class="text-[15px] font-bold text-text">{g.titre}</b>
                  <span class="text-sm leading-snug text-text-muted">{g.court}</span>
                </span>
              </li>
            ))}
          </ul>

          <a href="/qui-je-suis#statut" class={`${lienSection} self-start`}>
            Mon parcours et mon statut →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ========== GROUPES ========== -->
  <section aria-labelledby="groupes-titre" class="bg-primary-hover py-16 text-white md:py-24">
    <Container>
      <div class="flex flex-wrap items-start gap-x-14 gap-y-8">
        <div class="flex-[1_1_320px]">
          <p class="text-sm font-semibold uppercase tracking-widest text-on-primary-muted">En groupe</p>
          <h2 id="groupes-titre" class="mt-3 text-[1.65rem] font-bold leading-tight tracking-tight md:text-4xl">
            Une classe, une entreprise ? On construit le programme ensemble.
          </h2>
        </div>

        <ul class="grid flex-[1.4_1_480px] gap-4 sm:grid-cols-2">
          <li class="group relative flex flex-col gap-2.5 rounded-2xl border border-white/20 bg-white/10 p-6 transition hover:bg-white/15 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-white">
            <h3 class="text-xl font-bold">
              <a
                href="/groupes#scolaires"
                class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
              >
                Scolaires
              </a>
            </h3>
            <p class="leading-relaxed text-white/85">
              Sorties pédagogiques et classes de découverte, avec les
              justificatifs pour le dossier de sortie.
            </p>
            <span aria-hidden="true" class="mt-1 font-semibold text-secondary">
              Préparer une sortie scolaire →
            </span>
          </li>
          <li class="group relative flex flex-col gap-2.5 rounded-2xl border border-white/20 bg-white/10 p-6 transition hover:bg-white/15 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-white">
            <h3 class="text-xl font-bold">
              <a
                href="/groupes#entreprises"
                class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
              >
                Entreprises &amp; séminaires
              </a>
            </h3>
            <p class="leading-relaxed text-white/85">
              Une journée au vert ou un temps fort de séminaire, adapté à tous
              les niveaux de l'équipe.
            </p>
            <span aria-hidden="true" class="mt-1 font-semibold text-secondary">
              Demander un devis →
            </span>
          </li>
        </ul>
      </div>
    </Container>
  </section>

  <!-- ========== CARNET ========== -->
  {articles.length > 0 && (
    <section aria-labelledby="carnet-titre" class="bg-surface py-16 md:py-26">
      <Container>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class={surtitre}>Le carnet</p>
            <h2 id="carnet-titre" class={titreSection}>Conseils et récits de terrain</h2>
          </div>
          <a href="/carnet" class={lienSection}>Tout le carnet →</a>
        </div>

        <ul class="mt-8 grid border-y border-border md:mt-10 md:grid-cols-2 md:gap-6 md:border-0">
          {articles.map((article) => (
            <li class="group relative flex flex-col gap-2 border-border py-5 not-first:border-t md:rounded-3xl md:border md:bg-background md:p-8 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-focus has-[a:focus-visible]:ring-offset-2">
              <h3 class="text-lg font-bold leading-snug text-text md:text-[1.375rem]">
                <a
                  href={`/carnet/${article.id}`}
                  class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-hover:text-primary"
                >
                  {article.data.title}
                </a>
              </h3>
              <p class="order-first flex gap-3 text-sm text-text-muted">
                {article.data.tags?.[0] && (
                  <span class="font-semibold capitalize text-primary">{article.data.tags[0]}</span>
                )}
                <time datetime={article.data.pubDate.toISOString()}>
                  {formatDate(article.data.pubDate)}
                </time>
              </p>
              <p class="hidden leading-relaxed text-text-muted md:block">{article.data.description}</p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}

  <!-- ========== CONTACT ========== -->
  <section class="bg-primary py-16 md:py-24">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white md:text-5xl">
          Et si on partait en montagne ?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/85">
          Une envie, une idée d'itinéraire ou simplement besoin de conseils ?
          Écrivez-moi.
        </p>
        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-6">
          <Button href="/contact" variant="secondary" size="lg" class="group gap-3">
            Me contacter
            <span
              aria-hidden="true"
              class="transition-transform duration-200 motion-safe:group-hover:translate-x-1"
            >→</span>
          </Button>
          <a
            href={telHref}
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/60 px-7 font-semibold text-white transition hover:bg-white hover:text-primary sm:border-0 sm:px-0 sm:underline sm:underline-offset-4 sm:hover:bg-transparent sm:hover:text-white"
          >
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
            </svg>
            Appeler le {PHONE_NUMBER}
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
