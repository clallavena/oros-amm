---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import SortieCard from "../components/SortieCard.astro";
import { getSorties } from "../lib/sorties";

// Toutes les sorties publiées, triées (voir src/lib/sorties.ts).
const sorties = await getSorties();
---

<BaseLayout
  title="Sorties — Clément Allavena, Accompagnateur en Montagne"
  description="Découvrez les différentes sorties accompagnées en moyenne montagne : balades découverte, immersion nature et sorties sur mesure."
>
  <!-- HEADER DE PAGE -->
  <section class="bg-primary pb-20 pt-40 md:pb-28 md:pt-48">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/70">
        Sorties
      </p>
      <h1
        class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white md:text-6xl"
      >
        Des sorties pour tous les rythmes
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
        Que vous souhaitiez une balade tranquille ou une journée d'immersion
        complète, chaque sortie est pensée pour prendre le temps de découvrir la
        montagne.
      </p>
    </Container>
  </section>

  <!-- LISTE DES SORTIES -->
  <section class="bg-background py-24 md:py-32">
    <Container>
      <div class="grid gap-6 md:grid-cols-3">
        {sorties.map((sortie) => (
          <SortieCard sortie={sortie} headingLevel={2} />
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="bg-white py-24 md:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <SectionTitle
          align="center"
          eyebrow="Besoin de conseils ?"
          title="Vous ne savez pas quelle sortie choisir ?"
          description="Parlez-moi de vos envies, de votre niveau et de vos disponibilités, je vous aide à construire la sortie qui vous correspond."
        />
        <div class="mt-8 flex justify-center">
          <Button href="/contact">Me contacter</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
