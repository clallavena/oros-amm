---
import { NAV_LINKS, CONTACT_LINK, isActive } from "../lib/navigation";

const { pathname } = Astro.url;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <nav
      class="flex h-20 items-center justify-between"
      aria-label="Navigation principale"
    >

      <!-- LOGO -->
      <a
        href="/"
        class="flex items-center gap-3"
        aria-label="Retour à l'accueil"
      >
        <div
          id="logo-mark"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-primary shadow-sm transition-colors duration-300"
        >
          <span class="text-lg font-bold">
            A
          </span>
        </div>

        <div class="hidden sm:block">
          <p
            id="logo-name"
            class="text-sm font-bold leading-none text-white transition-colors duration-300"
          >
            Clément Allavena
          </p>

          <p
            id="logo-subtitle"
            class="mt-1 text-xs text-white/75 transition-colors duration-300"
          >
            Accompagnateur en montagne stagiaire
          </p>
        </div>
      </a>


      <!-- NAVIGATION DESKTOP -->
      <div class="hidden items-center gap-8 md:flex">

        {NAV_LINKS.map((link) => {
          const active = isActive(pathname, link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "nav-link text-sm text-white/90 transition-colors duration-300 hover:text-secondary",
                active
                  ? "font-semibold underline decoration-secondary decoration-2 underline-offset-[6px]"
                  : "font-medium",
              ]}
            >
              {link.label}
            </a>
          );
        })}

        <a
          href={CONTACT_LINK.href}
          aria-current={isActive(pathname, CONTACT_LINK.href) ? "page" : undefined}
          class="nav-cta rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-primary transition-all duration-300 hover:bg-secondary"
        >
          {CONTACT_LINK.label}
        </a>

      </div>


      <!-- BOUTON MOBILE -->
      <button
        id="mobile-menu-button"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-primary shadow-sm md:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </nav>


    <!-- MENU MOBILE -->
    <div
      id="mobile-menu"
      class="hidden rounded-2xl bg-white p-4 shadow-xl md:hidden"
    >

      <div class="flex flex-col gap-1">

        {NAV_LINKS.map((link) => {
          const active = isActive(pathname, link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-xl px-4 py-3 text-sm text-text transition hover:bg-background",
                active ? "bg-background font-semibold" : "font-medium",
              ]}
            >
              {link.label}
            </a>
          );
        })}

        <a
          href={CONTACT_LINK.href}
          aria-current={isActive(pathname, CONTACT_LINK.href) ? "page" : undefined}
          class="mt-2 rounded-xl bg-primary px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-primary-hover"
        >
          {CONTACT_LINK.label}
        </a>

      </div>

    </div>

  </div>
</header>


<script>
  const header = document.querySelector("#site-header");
  const logoName = document.querySelector("#logo-name");
  const logoSubtitle = document.querySelector("#logo-subtitle");
  const navLinks = document.querySelectorAll(".nav-link");
  const navCta = document.querySelector(".nav-cta");

  const updateHeader = () => {
    if (!header) return;

    const scrolled = window.scrollY > 50;

    header.classList.toggle("bg-white/70", scrolled);
    header.classList.toggle("shadow-sm", scrolled);
    header.classList.toggle("backdrop-blur-md", scrolled);

    logoName?.classList.toggle("text-white", !scrolled);
    logoName?.classList.toggle("text-primary", scrolled);

    logoSubtitle?.classList.toggle("text-white/75", !scrolled);
    logoSubtitle?.classList.toggle("text-text-muted", scrolled);

    navLinks.forEach((link) => {
      link.classList.toggle("text-white/90", !scrolled);
      link.classList.toggle("text-text", scrolled);
      link.classList.toggle("hover:text-secondary", !scrolled);
      link.classList.toggle("hover:text-primary", scrolled);

      // Soulignement de la page active : la couleur secondaire (claire) ne
      // contraste pas sur le fond blanc du header défilé, on passe au primary.
      if (link.getAttribute("aria-current") === "page") {
        link.classList.toggle("decoration-secondary", !scrolled);
        link.classList.toggle("decoration-primary", scrolled);
      }
    });

    navCta?.classList.toggle("bg-white", !scrolled);
    navCta?.classList.toggle("text-primary", !scrolled);
    navCta?.classList.toggle("hover:bg-secondary", !scrolled);

    navCta?.classList.toggle("bg-primary", scrolled);
    navCta?.classList.toggle("text-white", scrolled);
    navCta?.classList.toggle("hover:bg-primary-hover", scrolled);
  };


  window.addEventListener("scroll", updateHeader, {
    passive: true,
  });

  updateHeader();


  // MENU MOBILE

  const mobileButton = document.querySelector(
    "#mobile-menu-button"
  );

  const mobileMenu = document.querySelector(
    "#mobile-menu"
  );

  mobileButton?.addEventListener("click", () => {
    const isOpen =
      mobileButton.getAttribute("aria-expanded") === "true";

    mobileButton.setAttribute(
      "aria-expanded",
      String(!isOpen)
    );

    mobileMenu?.classList.toggle("hidden");
  });
</script>
