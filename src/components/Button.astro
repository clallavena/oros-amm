---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "light";
  size?: "md" | "lg";
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
} = Astro.props;

const variants = {
  primary:
    "bg-primary text-white hover:bg-primary/90",
  secondary:
    "bg-secondary text-white hover:bg-secondary/90",
  ghost:
    "border border-primary text-primary hover:bg-primary hover:text-white",
  light:
    "bg-secondary-light text-primary hover:bg-white",
};

const sizes = {
  md: "px-6 py-3 text-sm",
  lg: "px-9 py-4 text-base",
};

const classes = `
  inline-flex
  items-center
  justify-center
  rounded-full
  ${sizes[size]}
  font-semibold
  transition
  duration-200
  ${variants[variant]}
  ${className}
`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}