---
/*
 * Carte d'un univers sur le hub /sorties.
 *
 * L'attribut data-theme sur <article> applique le thème de l'univers à la
 * carte seule (voir global.css) : « la couleur de chaque carte annonce
 * l'ambiance de la page qui suit » (design, planche Hub Sorties).
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import { UNIVERS_INFO, type Univers } from "../lib/univers";
import { FORMAT_LABEL, formatPrix } from "../lib/formats";
import type { ResumeSorties } from "../lib/sorties";

interface Props {
  univers: Univers;
  resume: ResumeSorties;
  /** Photo de l'univers ; sans photo, un aplat avec le pictogramme. */
  photo?: { src: ImageMetadata; alt: string };
}

const { univers, resume, photo } = Astro.props;
const info = UNIVERS_INFO[univers];
---

<article
  data-theme={info.theme}
  aria-labelledby={`univers-${univers}`}
  class="flex flex-col overflow-hidden rounded-3xl border border-border bg-surface text-text"
>
  {photo ? (
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 33vw, 100vw"
      class="h-64 w-full object-cover md:h-72"
    />
  ) : (
    <div class="flex h-64 items-center justify-center bg-primary-light/25 text-primary md:h-72">
      <svg
        aria-hidden="true"
        width="72"
        height="72"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={info.icone} />
      </svg>
    </div>
  )}

  <div class="flex flex-1 flex-col gap-4 bg-background p-7">
    <p class="flex items-center gap-2 text-sm font-semibold text-primary">
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={info.icone} />
      </svg>
      {info.surtitre}
    </p>

    <h3 id={`univers-${univers}`} class="text-2xl font-bold leading-tight">
      {info.label}
    </h3>

    <p class="leading-relaxed text-text-muted">{info.accroche}</p>

    {resume.nombre > 0 ? (
      <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
        {resume.themes.length > 0 && (
          <>
            <dt class="text-text-muted">Thèmes</dt>
            <dd class="font-semibold">{resume.themes.join(" · ")}</dd>
          </>
        )}
        <dt class="text-text-muted">Formats</dt>
        <dd class="font-semibold">
          {resume.formats.map((f) => FORMAT_LABEL[f]).join(" · ")}
        </dd>
        {resume.prixDes !== undefined && (
          <>
            <dt class="text-text-muted">Dès</dt>
            <dd class="font-semibold">{formatPrix(resume.prixDes)} / pers.</dd>
          </>
        )}
      </dl>
    ) : (
      <p class="mt-1 text-sm font-semibold">Sorties en préparation</p>
    )}

    <div class="mt-auto pt-2">
      <Button href={`/sorties/${univers}`} class="w-full">
        {info.cta}
      </Button>
    </div>
  </div>
</article>
