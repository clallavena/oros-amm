---
/*
 * Hub /sorties
 * On entre par l'envie (l'univers), puis on choisit le format.
 * Les listes de sorties vivent sur les pages d'univers : /sorties/<univers>.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import UniversCard from "../components/UniversCard.astro";
import StatutEncadrement from "../components/StatutEncadrement.astro";
import { getCollection } from "astro:content";
import { UNIVERS, UNIVERS_INFO, type Univers } from "../lib/univers";
import { FORMATS, FORMAT_INFO, FORMAT_LABEL, NIVEAU_LABEL, formatPrix } from "../lib/formats";
import { getSorties, resumer } from "../lib/sorties";
import type { ImageMetadata } from "astro";

import randonneeImage from "../images/randonnee.jpg";

/* ---------- Données ---------- */

const sorties = await getSorties();

/* Photo de chaque univers. Sans photo, la carte affiche le pictogramme. */
const PHOTOS: Partial<Record<Univers, { src: ImageMetadata; alt: string }>> = {
  randonnee: { src: randonneeImage, alt: "Randonnée sur un sentier de montagne" },
  // hiver: { src: …, alt: "Groupe en raquettes dans la poudreuse" },
  // itinerance: { src: …, alt: "Sommet au crépuscule vu depuis le refuge" },
};

const univers = UNIVERS.map((u) => ({
  univers: u,
  resume: resumer(sorties.filter((s) => s.data.univers === u)),
}));

const formats = FORMATS.map((f) => ({
  format: f,
  info: FORMAT_INFO[f],
  resume: resumer(sorties.filter((s) => s.data.format === f)),
}));

/* 3 derniers récits du Carnet. */
const recits = (await getCollection("carnet"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });

/* Classes partagées par les en-têtes de section. */
const surtitre = "text-sm font-semibold uppercase tracking-widest text-primary";
const titreSection = "mt-3 text-3xl font-bold leading-tight tracking-tight text-text md:text-4xl";
---

<BaseLayout
  title="Sorties — Clément Allavena, Accompagnateur en montagne stagiaire"
  description="Randonnée au fil des saisons, raquettes sous la neige ou nuit en refuge : choisissez un univers, puis la formule qui vous ressemble."
>
  <!-- ========== HERO ========== -->
  <section class="bg-primary pb-20 pt-40 md:pb-28 md:pt-48">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/75">
        Sorties
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-6xl">
        Quelle montagne avez-vous envie de vivre ?
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">
        Randonnée au fil des saisons, raquettes sous la neige ou nuit en
        refuge : choisissez un univers, puis la formule qui vous ressemble.
      </p>

      <nav aria-label="Accès rapide aux univers" class="mt-9">
        <ul class="flex flex-wrap gap-3">
          {UNIVERS.map((u) => (
            <li>
              <a
                href={`/sorties/${u}`}
                class="inline-flex min-h-11 items-center gap-2.5 rounded-full border border-white/35 bg-white/10 px-4.5 text-sm font-semibold text-white transition hover:bg-white/20"
              >
                <!-- Pastille à la couleur d'accent de l'univers : data-theme local. -->
                <span
                  aria-hidden="true"
                  data-theme={UNIVERS_INFO[u].theme}
                  class="size-2.5 rounded-full bg-secondary"
                ></span>
                {UNIVERS_INFO[u].label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/groupes"
              class="inline-flex min-h-11 items-center rounded-full border border-dashed border-white/45 px-4.5 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Scolaires &amp; entreprises
            </a>
          </li>
        </ul>
      </nav>
    </Container>
  </section>

  <!-- ========== UNIVERS ========== -->
  <section aria-labelledby="univers-titre" class="py-24 md:py-28">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class={surtitre}>Trois univers</p>
          <h2 id="univers-titre" class={titreSection}>
            Chaque univers a sa saison, son rythme, sa lumière
          </h2>
        </div>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {univers.map(({ univers: u, resume }) => (
          <UniversCard univers={u} resume={resume} photo={PHOTOS[u]} />
        ))}
      </div>
    </Container>
  </section>

  <!-- ========== COMPARATIF DES FORMATS ========== -->
  <section aria-labelledby="formats-titre" class="bg-white py-24 md:py-28">
    <Container>
      <p class={surtitre}>Choisir son format</p>
      <h2 id="formats-titre" class={`${titreSection} max-w-2xl`}>
        Demi-journée, journée ou plusieurs jours ?
      </h2>

      <!--
        Sur mobile, le tableau défile horizontalement. tabindex="0" rend la zone
        atteignable au clavier pour pouvoir la faire défiler (WCAG 2.1.1).
      -->
      <div
        role="region"
        aria-labelledby="formats-titre"
        tabindex="0"
        class="mt-10 overflow-x-auto rounded-2xl border border-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        <table class="w-full min-w-[760px] border-collapse text-left text-[15px]">
          <caption class="sr-only">Comparatif des formats de sortie</caption>
          <thead>
            <tr class="bg-primary-light/25">
              <td class="px-6 py-4"></td>
              {formats.map(({ format }) => (
                <th scope="col" class="px-6 py-4 font-[family-name:var(--font-epilogue)] text-[17px] font-bold text-text">
                  {FORMAT_LABEL[format]}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="text-text">
            <tr class="border-t border-border">
              <th scope="row" class="px-6 py-4 font-medium text-text-muted">Durée</th>
              {formats.map(({ info }) => <td class="px-6 py-4">{info.duree}</td>)}
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-6 py-4 font-medium text-text-muted">Effort</th>
              {formats.map(({ info }) => (
                <td class="px-6 py-4">{NIVEAU_LABEL[info.effort]}</td>
              ))}
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-6 py-4 font-medium text-text-muted">Idéal pour</th>
              {formats.map(({ info }) => <td class="px-6 py-4">{info.idealPour}</td>)}
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-6 py-4 font-medium text-text-muted">Univers</th>
              {formats.map(({ info, resume }) => (
                <td class="px-6 py-4">
                  {info.universFixe ??
                    (resume.univers.length > 0
                      ? resume.univers.map((u) => UNIVERS_INFO[u].labelCourt).join(" · ")
                      : "Bientôt")}
                </td>
              ))}
            </tr>
            <tr class="border-t border-border bg-background">
              <th scope="row" class="px-6 py-4.5 font-medium text-text-muted">Dès / pers.</th>
              {formats.map(({ resume }) => (
                <td class="px-6 py-4.5 text-lg font-bold text-primary">
                  {resume.prixDes !== undefined ? formatPrix(resume.prixDes) : "—"}
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <!-- ========== GROUPES (renvoi vers /groupes) ========== -->
  <section aria-labelledby="groupes-titre" class="py-24 md:py-28">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class={surtitre}>En groupe</p>
          <h2 id="groupes-titre" class={titreSection}>
            Une classe, une équipe ? On construit le programme ensemble.
          </h2>
        </div>
      </div>

      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        <li class="flex flex-col gap-3 rounded-3xl border border-border bg-surface p-8">
          <h3 class="text-2xl font-bold text-text">Scolaires</h3>
          <p class="leading-relaxed text-text-muted">
            Sorties pédagogiques et classes de découverte, du primaire au
            lycée, en lien avec le projet de la classe.
          </p>
          <div class="mt-auto pt-3">
            <Button href="/groupes#scolaires" variant="ghost">Préparer une sortie scolaire</Button>
          </div>
        </li>
        <li class="flex flex-col gap-3 rounded-3xl border border-border bg-surface p-8">
          <h3 class="text-2xl font-bold text-text">Entreprises &amp; séminaires</h3>
          <p class="leading-relaxed text-text-muted">
            Une journée au vert ou un temps fort de séminaire : marcher
            ensemble, sortir du cadre.
          </p>
          <div class="mt-auto pt-3">
            <Button href="/groupes#entreprises" variant="ghost">Demander un devis</Button>
          </div>
        </li>
      </ul>
    </Container>
  </section>

  <!-- ========== STATUT ========== -->
  <div class="pb-24 md:pb-28">
    <Container>
      <StatutEncadrement />
    </Container>
  </div>

  <!-- ========== CARNET ========== -->
  {recits.length > 0 && (
    <section aria-labelledby="carnet-titre" class="bg-white py-24 md:py-28">
      <Container>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class={surtitre}>Carnet de terrain</p>
            <h2 id="carnet-titre" class={titreSection}>Les derniers récits</h2>
          </div>
          <a
            href="/carnet"
            class="inline-flex min-h-11 items-center font-semibold text-primary underline-offset-4 hover:underline"
          >
            Tout le carnet →
          </a>
        </div>

        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {recits.map((recit) => (
            <li class="group relative flex flex-col gap-3 rounded-2xl bg-background p-7 transition hover:shadow-lg has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-focus has-[a:focus-visible]:ring-offset-2">
              {recit.data.tags?.[0] && (
                <span class="self-start rounded-full bg-primary-light/30 px-3 py-1 text-[13px] font-semibold text-primary">
                  {recit.data.tags[0]}
                </span>
              )}
              <h3 class="text-xl font-bold leading-snug text-text">
                <!-- Lien étendu à toute la carte (même modèle que SortieCard). -->
                <a
                  href={`/carnet/${recit.id}`}
                  class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-hover:text-primary"
                >
                  {recit.data.title}
                </a>
              </h3>
              <p class="text-sm text-text-muted">
                <time datetime={recit.data.pubDate.toISOString()}>
                  {formatDate(recit.data.pubDate)}
                </time>
              </p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}

  <!-- ========== CTA ========== -->
  <section class="bg-primary py-24 md:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white md:text-5xl">
          Pas sûr de votre choix ?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/80">
          Dites-moi qui vous êtes, vos dates et votre niveau : je vous oriente
          vers la bonne sortie.
        </p>
        <div class="mt-8 flex justify-center">
          <Button href="/contact" variant="secondary" size="lg">
            Me contacter <span aria-hidden="true" class="ml-2">→</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
