---
/*
 * Fiche d'une sortie : /sorties/<univers>/<id>
 * Version de base (lot 3) : la mise en page complète du design arrive au lot 5.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
import Button from "../../../components/Button.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { UNIVERS_INFO } from "../../../lib/univers";
import { getSorties, type Sortie } from "../../../lib/sorties";
import {
  FORMAT_LABEL,
  NIVEAU_LABEL,
  formatPrix,
  formatNombre,
} from "../../../lib/formats";

export async function getStaticPaths() {
  const sorties = await getSorties();
  return sorties.map((sortie) => ({
    params: { univers: sortie.data.univers, slug: sortie.id },
    props: { sortie },
  }));
}

interface Props {
  sortie: Sortie;
}

const { sortie } = Astro.props;
const { data } = sortie;
const { Content } = await render(sortie);
const info = UNIVERS_INFO[data.univers];

/* Chiffres clés : on n'affiche que ceux qui sont renseignés. */
const chiffres: { label: string; valeur: string }[] = [];
if (data.duree) chiffres.push({ label: "Durée", valeur: data.duree });
if (data.marcheParJour) chiffres.push({ label: "Marche / jour", valeur: data.marcheParJour });
if (data.distanceKm) chiffres.push({ label: "Distance", valeur: `${formatNombre(data.distanceKm)} km` });
if (data.deniveleM !== undefined) chiffres.push({ label: "Dénivelé", valeur: `+${formatNombre(data.deniveleM)} m` });
if (data.altitudeMaxM) chiffres.push({ label: "Altitude max.", valeur: `${formatNombre(data.altitudeMaxM)} m` });
chiffres.push({ label: "Niveau", valeur: NIVEAU_LABEL[data.niveau] });
chiffres.push({
  label: "Groupe",
  valeur: data.groupe.max
    ? `${data.groupe.min} à ${data.groupe.max} pers.`
    : `Dès ${data.groupe.min} pers.`,
});

const [photoPrincipale, ...autresPhotos] = [data.couverture, ...data.galerie];
---

<BaseLayout
  title={`${data.title} — ${info.label} — Clément Allavena`}
  description={data.description}
  theme={info.theme}
>
  <!-- EN-TÊTE -->
  <section class="bg-primary pb-16 pt-40 md:pb-20 md:pt-48">
    <Container>
      <nav aria-label="Fil d'Ariane" class="text-sm text-white/80">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/sorties" class="text-white underline-offset-4 hover:underline">Sorties</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/sorties/${data.univers}`} class="text-white underline-offset-4 hover:underline">
              {info.label}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-6 flex flex-wrap gap-2">
        <span class="rounded-full bg-secondary px-3 py-1 text-sm font-semibold text-on-secondary">
          {FORMAT_LABEL[data.format]}
        </span>
        {data.duree && (
          <span class="rounded-full bg-white/15 px-3 py-1 text-sm font-semibold text-white">
            {data.duree}
          </span>
        )}
      </div>

      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-6xl">
        {data.title}
      </h1>

      {data.lieu && (
        <p class="mt-4 text-lg text-white/85">
          Massif {data.lieu.massif}
          {data.lieu.depart && <> · Départ {data.lieu.depart}</>}
        </p>
      )}
    </Container>
  </section>

  <!-- PHOTOS -->
  <Container class="pt-8">
    <div class:list={["grid gap-4", autresPhotos.length > 0 && "md:grid-cols-3"]}>
      <Image
        src={photoPrincipale.src}
        alt={photoPrincipale.alt}
        widths={[640, 960, 1280]}
        sizes={autresPhotos.length > 0 ? "(min-width: 768px) 66vw, 100vw" : "100vw"}
        class:list={[
          "h-72 w-full rounded-3xl object-cover md:h-[420px]",
          autresPhotos.length > 0 && "md:col-span-2",
        ]}
        loading="eager"
      />
      {autresPhotos.length > 0 && (
        <div class="grid gap-4">
          {autresPhotos.slice(0, 2).map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 640]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="h-48 w-full rounded-3xl object-cover md:h-full"
            />
          ))}
        </div>
      )}
    </div>
  </Container>

  <!-- CHIFFRES CLÉS -->
  <Container class="pt-6">
    <dl class="grid grid-cols-2 overflow-hidden rounded-3xl border border-border bg-surface sm:grid-cols-3 lg:grid-cols-[repeat(auto-fit,minmax(140px,1fr))]">
      {chiffres.map((c) => (
        <div class="border-b border-r border-border p-5">
          <dt class="text-sm text-text-muted">{c.label}</dt>
          <dd class="mt-1 text-lg font-bold text-text">{c.valeur}</dd>
        </div>
      ))}
    </dl>
  </Container>

  <!-- CORPS + RÉSERVATION -->
  <Container class="py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_340px]">
      <div class="flex flex-col gap-14">
        <section aria-labelledby="idee-titre">
          <h2 id="idee-titre" class="text-3xl font-bold text-text">L'idée</h2>
          <div class="fiche-content mt-4 max-w-2xl">
            <Content />
          </div>

          {data.themes.length > 0 && (
            <ul aria-label="Thèmes abordés" class="mt-6 flex flex-wrap gap-2">
              {data.themes.map((theme) => (
                <li class="rounded-full bg-primary-light/30 px-4 py-1.5 text-sm font-semibold text-primary">
                  {theme}
                </li>
              ))}
            </ul>
          )}
        </section>

        {data.programme.length > 0 && (
          <section aria-labelledby="programme-titre">
            <h2 id="programme-titre" class="text-3xl font-bold text-text">Le programme</h2>
            <ol class="mt-6">
              {data.programme.map((etape) => (
                <li class="grid grid-cols-[96px_1fr] gap-5 border-t border-border py-4 last:border-b">
                  <span class="font-bold text-primary">
                    {etape.moment}
                    {etape.heure && (
                      <span class="block text-sm font-medium text-text-muted">{etape.heure}</span>
                    )}
                  </span>
                  <span class="text-text">{etape.texte}</span>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      <!-- RÉSERVATION -->
      <aside
        aria-labelledby="reserver-titre"
        class="flex h-fit flex-col gap-5 rounded-3xl border border-border bg-surface p-7 shadow-sm lg:sticky lg:top-28"
      >
        <h2 id="reserver-titre" class="sr-only">Réserver</h2>

        <div class="flex items-baseline justify-between gap-3">
          <span class="text-sm text-text-muted">Dès, par personne</span>
          <span class="text-3xl font-bold text-primary">{formatPrix(data.prix.des)}</span>
        </div>
        {data.prix.jusqua && (
          <p class="-mt-3 text-sm text-text-muted">
            Jusqu'à {formatPrix(data.prix.jusqua)} par personne
          </p>
        )}

        {data.inclus.length > 0 && (
          <ul class="flex list-disc flex-col gap-1.5 pl-5 text-sm text-text">
            {data.inclus.map((item) => <li>{item}</li>)}
          </ul>
        )}

        <Button href={`/contact?sortie=${sortie.id}`} class="w-full">
          Réserver cette sortie
        </Button>
        <Button href="/contact" variant="ghost" class="w-full">
          Poser une question
        </Button>

        <p class="border-t border-border pt-4 text-sm text-text-muted">
          Encadrement par un accompagnateur en montagne stagiaire, sous
          convention de stage.
          <a href="/a-propos" class="font-semibold text-primary underline">Mon statut</a>
        </p>
      </aside>
    </div>
  </Container>
</BaseLayout>

<style>
  .fiche-content :global(p) {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .fiche-content :global(p:first-child) {
    margin-top: 0;
  }
</style>
