---
import Container from "./Container.astro";
import { NAV_LINKS } from "../lib/navigation";
import { CONTACT_EMAIL, NOM_SITE, NOM_SITE_HREF, PHONE_NUMBER } from "../lib/site";
import { NUMERO_DECLARATION, TITRE_MAJ } from "../lib/statut";

const year = new Date().getFullYear();

const navLinks = [...NAV_LINKS, { href: "/contact", label: "Contact" }, { href: "/mentions-legales", label: "Mentions légales" }];

/*
 * Numéro de déclaration d'éducateur sportif (carte professionnelle).
 *
 */
const declarationNumero = NUMERO_DECLARATION;
---

<footer class="bg-primary text-white">
  <Container class="py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <!-- Identité -->
      <div>
        <p class="text-lg font-bold">Clément Allavena</p>
        <p class="mt-2 text-sm leading-relaxed text-white/70">
          {TITRE_MAJ} en formation au DE. Des sorties pour
          découvrir la montagne à votre rythme.
        </p>
        <!--
          Signature : le nom du site expliqué en une phrase, sur toutes les
          pages. Le lien mène à la version complète dans Qui je suis.
        -->
        <p class="mt-4 border-t border-white/15 pt-4 text-sm leading-relaxed text-white/85">
          <b class="font-bold text-white">{NOM_SITE}</b> : <span lang="grc" class="font-serif">ὄρος</span>,
          signifie "la montagne" en grec ancien, et le sens, celui du chemin, des choses, de nos ressentie
          et de nos sens.&nbsp;
          <a href={NOM_SITE_HREF} class="font-semibold text-secondary underline-offset-4 hover:underline">
            D'où vient ce nom&nbsp;?
          </a>
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-labelledby="footer-nav-titre">
        <p
          id="footer-nav-titre"
          class="text-sm font-semibold uppercase tracking-widest text-on-primary-muted"
        >
          Navigation
        </p>
        <ul class="mt-4 flex flex-col gap-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/80 transition hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-on-primary-muted">
          Contact
        </p>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-white/80">
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="transition hover:text-white">
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a href={`tel:${PHONE_NUMBER.replace(/[\s\-\(\)]/g, '')}`} class="transition hover:text-white">
              {PHONE_NUMBER}
            </a>
          </li>
          <li>Annecy, Haute-Savoie</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/15 pt-8 text-xs text-on-primary-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Clément Allavena — {TITRE_MAJ}.</p>
      {declarationNumero && (
        <p>Déclaration d'éducateur sportif n° 
          <a href={"https://recherche-educateur.sports.gouv.fr/IdentifiantStagiaire/d9fd7b12-58ec-41ba-9041-4a18d65a7856"}
            target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{declarationNumero}
          </a>
        </p>
      )}
    </div>
  </Container>
</footer>
