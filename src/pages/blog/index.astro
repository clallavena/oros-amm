---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title="Blog — Clément Allavena, Accompagnateur en Montagne"
  description="Conseils, observations et récits de sorties en moyenne montagne."
>
  <!-- HEADER DE PAGE -->
  <section class="bg-primary pb-20 pt-40 md:pb-28 md:pt-48">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/70">
        Blog
      </p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white md:text-6xl">
        Carnets de montagne
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
        Conseils pratiques, observations de terrain et récits de
        sorties.
      </p>
    </Container>
  </section>

  <!-- LISTE DES ARTICLES -->
  <section class="bg-background py-24 md:py-32">
    <Container>
      {posts.length === 0 ? (
        <p class="text-text-muted">Aucun article pour le moment.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block rounded-2xl bg-surface p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
            >
              <p class="text-xs font-semibold uppercase tracking-widest text-primary">
                {formatDate(post.data.pubDate)}
              </p>
              <h2 class="mt-3 text-xl font-bold text-text group-hover:text-primary">
                {post.data.title}
              </h2>
              <p class="mt-3 leading-relaxed text-text-muted">
                {post.data.description}
              </p>
              <span class="mt-5 inline-block font-semibold text-primary">
                Lire l'article →
              </span>
            </a>
          ))}
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
